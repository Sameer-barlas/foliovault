# FolioVault Android Build Configuration
# Pass public endpoints via Gradle properties (-PAPI_BASE_URL=...) or environment variables:
#   API_BASE_URL=https://your-foliovault-backend.vercel.app
#   GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
#   FIRESTORE_DATABASE_ID=(default)
#
# Backend service account secrets live exclusively in backend/.env (never in the Android APK).
