# Firebase Admin SDK service account credentials (set in Vercel/Render env vars; NEVER commit .env)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional Firestore database ID (defaults to "(default)" for Firebase Spark free tier)
FIRESTORE_DATABASE_ID=(default)

# OAuth 2.0 Web Client ID from Firebase / Google Cloud Console (used as audience for Google ID token verification)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Super-admin Gmail bootstrapped on first login
SUPER_ADMIN_EMAIL=muhamad517uet@gmail.com

# App Check enforcement toggle (keep false during sideload testing; set true after verifying Play Integrity)
APPCHECK_ENFORCE=false

# Local / Render HTTP port
PORT=3000
